<Project>

  <PropertyGroup>
    <!-- Keep NuGet assets and generated files isolated per project and host OS in shared workspaces. -->
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\$(OS)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
