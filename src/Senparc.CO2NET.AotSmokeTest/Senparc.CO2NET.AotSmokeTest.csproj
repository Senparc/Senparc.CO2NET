<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>
      [2026-07-21] v1.0.0 Add System.Text.Json Native AOT smoke verification
      1. Verify JsonTypeInfo source-generation paths for ToJson, GetObject, and cache serialization.
      2. Verify osx-arm64 Native AOT native compile, link, and run results.
      [2026-07-22] v1.1.0 Expand Native AOT runtime coverage
      1. Cover System.Type registration conversion, JSON DOM, cache, and source-generated GET/POST request paths.
      2. Treat IL2026 and IL3050 as errors and verify osx-arm64 native binary execution.
      [2026-07-26] v1.2.0 Include in solution and CI; align with Senparc.CO2NET 4.2.0 IsAotCompatible core library
    </PackageReleaseNotes>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Senparc.CO2NET\Senparc.CO2NET.csproj" />
  </ItemGroup>
</Project>
